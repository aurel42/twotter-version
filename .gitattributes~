# Documentation is plain text; keep it LF everywhere, on every checkout.
*.md       text eol=lf
*.xml      text eol=lf
*.xml.user text eol=lf
*.yml      text eol=lf

# Topic patches for the vendored WT GNS carry the patched files' own bytes, CRLF and LF
# alike. Git must never rewrite their endings, or they stop applying. scripts/gns-patches/
*.patch    -text

# Package sources. Their rules live here, not in a .gitattributes next to the files: a
# folder that is an AssetDir is packaged verbatim, and the file would ship to every user.
# .md and .xml are covered by the global rules above.
PackageSources/kap140-mod/**/*.css            text eol=lf
PackageSources/kap140-mod/**/*.html           text eol=lf
PackageSources/kap140-mod/**/*.js             text eol=lf
PackageSources/kap140-mod/**/*.json           text eol=lf
PackageSources/kap140-mod/**/*.ts             text eol=lf

PackageSources/kr87-mod/**/*.css              text eol=lf
PackageSources/kr87-mod/**/*.html             text eol=lf
PackageSources/kr87-mod/**/*.js               text eol=lf

